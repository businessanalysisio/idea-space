# Postgres connection string. Leave unset for local development — the app
# falls back to a local SQLite file (idea_space.db) automatically.
# Vercel Postgres sets this for you when the integration is linked.
DATABASE_URL=

# Shared password gating the whole app (HTTP Basic Auth, any username).
# Leave unset to run with no password gate (local dev default). This app
# has no per-user login — set this before deploying anywhere public.
SITE_PASSWORD=
